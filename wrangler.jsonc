{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fondarkivet",
  "main": "src/fondarkivet/web/worker.js",
  "compatibility_date": "2026-11-23",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "fondarkivet.se", "custom_domain": true }],
  "r2_buckets": [
    { "binding": "NAV_ARCHIVE", "bucket_name": "fondarkivet-nav" }
  ],
  "assets": {
    "directory": "./dist/worker",
    "binding": "ASSETS",
    "run_worker_first": ["/v1/*"]
  }
}
